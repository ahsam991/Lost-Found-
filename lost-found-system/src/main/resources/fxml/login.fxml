<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
           fx:controller="com.campus.lostfound.controller.LoginController" 
           prefWidth="1024.0" prefHeight="768.0" style="-fx-background-color: #f9f9ff;">
    
    <VBox spacing="24" alignment="CENTER" maxWidth="400.0" maxHeight="550.0" 
          style="-fx-background-color: white; -fx-background-radius: 12px; -fx-padding: 40px; 
                 -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 4); 
                 -fx-border-color: #E5E7EB; -fx-border-radius: 12px; -fx-border-width: 1px;">
        
        <!-- App Title and Brand -->
        <VBox spacing="8" alignment="CENTER">
            <Label text="Smart Campus" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #004ac6;"/>
            <Label text="Lost &amp; Found System" style="-fx-font-size: 14px; -fx-text-fill: #6B7280;"/>
        </VBox>
        
        <VBox spacing="16" alignment="CENTER_LEFT">
            <!-- Email field -->
            <VBox spacing="6">
                <Label text="Email Address" style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <TextField fx:id="emailField" promptText="student@campus.edu" prefHeight="40.0" />
            </VBox>
            
            <!-- Password field -->
            <VBox spacing="6">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #111827;" HBox.hgrow="ALWAYS"/>
                    <Region HBox.hgrow="ALWAYS" />
                    <Hyperlink text="Forgot Password?" fx:id="forgotPasswordLink" onAction="#handleForgotPassword" style="-fx-text-fill: #2563eb;"/>
                </HBox>
                <PasswordField fx:id="passwordField" promptText="••••••••" prefHeight="40.0"/>
            </VBox>
            
            <!-- Remember Me -->
            <CheckBox fx:id="rememberMeCheckbox" text="Remember me for 30 days" style="-fx-text-fill: #111827;"/>
        </VBox>
        
        <!-- Status / Error message container -->
        <Label fx:id="errorLabel" text="" style="-fx-text-fill: #EF4444; -fx-font-weight: bold;" wrapText="true"/>
        
        <!-- Action Buttons -->
        <VBox spacing="12" alignment="CENTER" fillWidth="true">
            <Button text="Sign In" onAction="#handleLogin" styleClass="button-primary" prefHeight="40.0" maxWidth="Infinity" />
            
            <HBox alignment="CENTER" spacing="10">
                <Separator HBox.hgrow="ALWAYS"/>
                <Label text="OR" style="-fx-text-fill: #6B7280; -fx-font-size: 11px;"/>
                <Separator HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <Button text="Student/Staff ID Login" styleClass="button-secondary" prefHeight="40.0" maxWidth="Infinity" />
        </VBox>
        
        <!-- Register Link -->
        <HBox alignment="CENTER" spacing="4">
            <Label text="Don't have an account?" style="-fx-text-fill: #6B7280;"/>
            <Hyperlink text="Register" onAction="#goToRegister" style="-fx-text-fill: #2563eb; -fx-font-weight: bold;"/>
        </HBox>
    </VBox>
</StackPane>
